#!/usr/bin/env python3
"""caveman — Hermes-native caveman mode, usage ledger and honest stats.

Replaces the Claude-Code-only caveman hook trio (mode tracker + JSONL transcript
reader + statusline) with Hermes primitives:

  state   $HERMES_HOME/state/caveman.json          mode per session / default
  ledger  $HERMES_HOME/state/caveman-ledger.jsonl  one row per API call
  turns   $HERMES_HOME/state.db                    session + message store

Modes: caveman | ultracave | megacave | off

Numbers come from the ledger written by the post_api_request shell hook and
from Hermes's own session store. Savings stay unknown: no measured comparison
against a non-caveman run of the same session exists, so none is invented.

Python 3.9+ stdlib only.
"""
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
import time
from pathlib import Path

MODES = ("caveman", "ultracave", "megacave")
OFF_VALUES = ("off", "normal", "none", "stop", "full")
ALIASES = {
    "ultra": "ultracave",
    "uc": "ultracave",
    "mega": "megacave",
    "wenyan": "megacave",
    "wen-yan": "megacave",
    "cave": "caveman",
    "lite": "caveman",
    "manual": "off",
}
SESSION_WINDOW = 200  # keep state.json bounded


def hermes_home() -> Path:
    home = os.environ.get("HERMES_HOME") or ""
    return Path(home).expanduser() if home else Path.home() / ".hermes"


STATE_PATH = hermes_home() / "state" / "caveman.json"
LEDGER_PATH = hermes_home() / "state" / "caveman-ledger.jsonl"
STATE_DB = hermes_home() / "state.db"
UPSTREAM_CONFIG = Path.home() / ".config" / "caveman" / "config.json"


# ---------------------------------------------------------------- mode state

def normalize_mode(value):
    """'ultra' -> 'ultracave'; 'full' -> 'off'; unknown -> None."""
    if not isinstance(value, str):
        return None
    v = value.strip().lower()
    if not v:
        return None
    if v in MODES:
        return v
    if v in OFF_VALUES:
        return "off"
    return ALIASES.get(v)


def load_state():
    try:
        data = json.loads(STATE_PATH.read_text(encoding="utf-8"))
        if isinstance(data, dict):
            data.setdefault("sessions", {})
            data.setdefault("default", None)
            if isinstance(data["sessions"], dict):
                return data
    except FileNotFoundError:
        pass
    except (json.JSONDecodeError, OSError, UnicodeDecodeError):
        pass
    return {"default": None, "sessions": {}}


def save_state(state):
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    sessions = state.get("sessions") or {}
    if len(sessions) > SESSION_WINDOW:
        keep = sorted(sessions.items(), key=lambda kv: kv[1].get("set_at", 0))[-SESSION_WINDOW:]
        state["sessions"] = dict(keep)
    tmp = STATE_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(STATE_PATH)


def upstream_default():
    try:
        raw = json.loads(UPSTREAM_CONFIG.read_text(encoding="utf-8"))
        if isinstance(raw, dict):
            return normalize_mode(raw.get("defaultMode") or raw.get("default_mode"))
    except (FileNotFoundError, json.JSONDecodeError, OSError, UnicodeDecodeError):
        pass
    return None


def resolve_mode(session_id=None, state=None):
    """(mode, source) for a session. Session entry wins over every global default."""
    st = state if state is not None else load_state()
    sid = session_id or ""
    if sid:
        entry = (st.get("sessions") or {}).get(sid)
        if isinstance(entry, dict) and entry.get("mode"):
            return entry["mode"], "session"
    env = normalize_mode(os.environ.get("CAVEMAN_DEFAULT_MODE", ""))
    if env:
        return env, "env:CAVEMAN_DEFAULT_MODE"
    dflt = normalize_mode(st.get("default") or "")
    if dflt:
        return dflt, "default"
    up = upstream_default()
    if up:
        return up, "upstream-config"
    return "off", "unset"


def session_id_from_env():
    return os.environ.get("HERMES_SESSION_ID") or ""


def cmd_status(args):
    sid = args.session or session_id_from_env()
    mode, source = resolve_mode(sid)
    if args.json:
        print(json.dumps({"session_id": sid, "mode": mode, "source": source}))
        return 0
    print(f"Caveman mode: {mode}")
    print(f"session: {sid or '(none)'}  source: {source}")
    return 0


def cmd_set(args):
    target = normalize_mode(args.mode)
    if target is None:
        print(f"unknown mode: {args.mode!r}. valid: {', '.join(MODES + ('off',))}", file=sys.stderr)
        return 2
    state = load_state()
    if args.global_scope:
        state["default"] = target
        scope = "global default"
    else:
        sid = args.session or session_id_from_env()
        if not sid:
            print("no session id (set $HERMES_SESSION_ID or pass --session); use --global to set the default",
                  file=sys.stderr)
            return 2
        state["sessions"][sid] = {"mode": target, "set_at": time.time()}
        scope = f"session {sid}"
    save_state(state)
    print(f"Caveman mode: {target} ({scope})")
    return 0


# --------------------------------------------------------------- usage ledger

def load_ledger(path=None):
    rows = []
    p = Path(path) if path else LEDGER_PATH
    try:
        with p.open("r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if isinstance(row, dict):
                    rows.append(row)
    except FileNotFoundError:
        pass
    return rows


def db_rows(session_id=None, since_ts=None):
    if not STATE_DB.exists():
        return []
    cols = ("id, source, model, started_at, ended_at, message_count, tool_call_count, "
            "input_tokens, output_tokens, cache_read_tokens, cache_write_tokens, reasoning_tokens")
    sql = f"SELECT {cols} FROM sessions"
    where, params = [], []
    if session_id:
        where.append("id = ?")
        params.append(session_id)
    if since_ts:
        where.append("started_at >= ?")
        params.append(since_ts)
    if where:
        sql += " WHERE " + " AND ".join(where)
    sql += " ORDER BY started_at DESC"
    try:
        with sqlite3.connect(f"file:{STATE_DB}?mode=ro", uri=True) as con:
            con.row_factory = sqlite3.Row
            return [dict(r) for r in con.execute(sql, params)]
    except sqlite3.Error as exc:
        print(f"warning: cannot read {STATE_DB}: {exc}", file=sys.stderr)
        return []


def assistant_turns(session_id):
    if not session_id or not STATE_DB.exists():
        return 0
    try:
        with sqlite3.connect(f"file:{STATE_DB}?mode=ro", uri=True) as con:
            cur = con.execute(
                "SELECT COUNT(*) FROM messages WHERE session_id = ? AND role = 'assistant'", (session_id,)
            )
            return int(cur.fetchone()[0])
    except sqlite3.Error:
        return 0


def newest_session_id():
    if not STATE_DB.exists():
        return ""
    try:
        with sqlite3.connect(f"file:{STATE_DB}?mode=ro", uri=True) as con:
            cur = con.execute("SELECT session_id FROM messages ORDER BY timestamp DESC LIMIT 1")
            row = cur.fetchone()
            return row[0] if row else ""
    except sqlite3.Error:
        return ""


def parse_since(text):
    """'7d' | '24h' | '90m' -> epoch cutoff."""
    unit = text.strip().lower()[-1:]
    try:
        n = float(text.strip()[:-1])
    except ValueError:
        raise SystemExit(f"bad --since value: {text!r} (use 30m, 24h, 7d)")
    mult = {"m": 60, "h": 3600, "d": 86400}.get(unit)
    if not mult:
        raise SystemExit(f"bad --since unit: {text!r} (use m, h or d)")
    return time.time() - n * mult


# A single API call reporting more output tokens than this is almost always a
# provider returning cumulative counters instead of per-call usage. Flagged, not
# silently corrected: the recorded number stays, the reader is told it is suspect.
SUSPECT_OUTPUT_TOKENS = 32768


def summarize_ledger(rows):
    out = {"calls": 0, "input": 0, "output": 0, "cache_read": 0, "cache_write": 0, "reasoning": 0,
           "modes": {}, "suspect_calls": 0, "max_call_output": 0}
    for r in rows:
        out["calls"] += 1
        for key, field in (("input", "input_tokens"), ("output", "output_tokens"),
                           ("cache_read", "cache_read_tokens"), ("cache_write", "cache_write_tokens"),
                           ("reasoning", "reasoning_tokens")):
            try:
                out[key] += int(r.get(field) or 0)
            except (TypeError, ValueError):
                pass
        try:
            call_out = int(r.get("output_tokens") or 0)
        except (TypeError, ValueError):
            call_out = 0
        out["max_call_output"] = max(out["max_call_output"], call_out)
        if call_out > SUSPECT_OUTPUT_TOKENS:
            out["suspect_calls"] += 1
        mode = r.get("mode") or "unknown"
        bucket = out["modes"].setdefault(mode, {"calls": 0, "output": 0, "cache_read": 0, "input": 0})
        bucket["calls"] += 1
        for key, field in (("output", "output_tokens"), ("cache_read", "cache_read_tokens"),
                           ("input", "input_tokens")):
            try:
                bucket[key] += int(r.get(field) or 0)
            except (TypeError, ValueError):
                pass
    return out


def fmt(n):
    return f"{n:,}"


def render_session_report(sid, rows, session_row, current_mode, mode_source, share=False):
    led = summarize_ledger(rows)
    lines = []
    lines.append("Caveman Stats — Hermes native")
    lines.append("──────────────────────────────────")
    if not share:
        lines.append(f"Session:   {sid or '(none)'}")
    model = (session_row or {}).get("model") or (rows[-1].get("model") if rows else "") or "unknown"
    lines.append(f"Model:     {model}")
    turns = assistant_turns(sid)
    tool_calls = int((session_row or {}).get("tool_call_count") or 0)
    lines.append(f"Turns:     {turns} assistant message(s), {tool_calls} tool call(s)")
    lines.append("──────────────────────────────────")
    if led["calls"]:
        lines.append(f"Output tokens:         {fmt(led['output'])}")
        lines.append(f"Cache-read tokens:     {fmt(led['cache_read'])}")
        lines.append(f"Input (uncached):      {fmt(led['input'])}")
        if led["reasoning"]:
            lines.append(f"Reasoning tokens:      {fmt(led['reasoning'])}")
        lines.append(f"Recorded API calls:    {fmt(led['calls'])}")
        lines.append("Source: caveman ledger (post_api_request hook)")
    elif session_row:
        lines.append(f"Output tokens:         {fmt(int(session_row.get('output_tokens') or 0))}")
        lines.append(f"Cache-read tokens:     {fmt(int(session_row.get('cache_read_tokens') or 0))}")
        lines.append(f"Input (uncached):      {fmt(int(session_row.get('input_tokens') or 0))}")
        if session_row.get("reasoning_tokens"):
            lines.append(f"Reasoning tokens:      {fmt(int(session_row['reasoning_tokens']))}")
        lines.append("Source: Hermes state.db (no ledger rows for this session —")
        lines.append("        hooks were not wired while it ran)")
    else:
        lines.append("Output tokens:         0")
        lines.append("Cache-read tokens:     0")
        lines.append("Source: nothing recorded for this session")
    lines.append("──────────────────────────────────")
    lines.append(f"Mode: {current_mode} (current; source: {mode_source})")
    if led["modes"]:
        lines.append("By mode (recorded API calls):")
        for mode in sorted(led["modes"], key=lambda m: -led["modes"][m]["calls"]):
            b = led["modes"][mode]
            lines.append(f"  {mode:<10} {b['calls']:>4} call(s)  {fmt(b['output']):>10} output  "
                         f"{fmt(b['cache_read']):>12} cache-read")
    else:
        lines.append("By mode: unknown — no per-call ledger rows.")
    lines.append("──────────────────────────────────")
    if led["suspect_calls"]:
        lines.append(f"Note: {led['suspect_calls']} call(s) reported more than "
                     f"{SUSPECT_OUTPUT_TOKENS:,} output tokens in one request")
        lines.append(f"      (max {fmt(led['max_call_output'])}) — likely cumulative provider usage.")
    lines.append("Savings: unknown — no measured comparison for this session.")
    return "\n".join(lines)


def cmd_stats(args):
    since_ts = parse_since(args.since) if args.since else None
    sid = args.session or ""
    ledger = load_ledger()
    if since_ts:
        ledger = [r for r in ledger if float(r.get("ts") or 0) >= since_ts]

    if args.all or args.since:
        by_sid = {}
        for r in ledger:
            by_sid.setdefault(r.get("session") or "(unknown)", []).append(r)
        if args.json:
            payload = []
            for s, rows in by_sid.items():
                agg = summarize_ledger(rows)
                agg["session"] = s
                payload.append(agg)
            print(json.dumps({"since": args.since, "sessions": payload}, indent=2))
            return 0
        lines = [f"Caveman Stats — Hermes native ({args.since or 'all recorded ledger rows'})",
                 "──────────────────────────────────"]
        if not by_sid:
            lines.append("No ledger rows recorded yet.")
        total = {"calls": 0, "output": 0, "cache_read": 0}
        for s, rows in sorted(by_sid.items(), key=lambda kv: -max(float(r.get("ts") or 0) for r in kv[1])):
            agg = summarize_ledger(rows)
            total["calls"] += agg["calls"]
            total["output"] += agg["output"]
            total["cache_read"] += agg["cache_read"]
            lines.append(f"{s[:22]:<22} {agg['calls']:>4} call(s)  {fmt(agg['output']):>10} output  "
                         f"{fmt(agg['cache_read']):>12} cache-read")
        if by_sid:
            lines.append("──────────────────────────────────")
            lines.append(f"{'TOTAL':<22} {total['calls']:>4} call(s)  {fmt(total['output']):>10} output  "
                         f"{fmt(total['cache_read']):>12} cache-read")
        lines.append("──────────────────────────────────")
        suspect = sum(summarize_ledger(rows)["suspect_calls"] for rows in by_sid.values()) if by_sid else 0
        if suspect:
            lines.append(f"Note: {suspect} call(s) reported >{SUSPECT_OUTPUT_TOKENS:,} output tokens ")
            lines.append("      in one request — likely cumulative provider usage.")
        lines.append("Savings: unknown — no measured comparison exists.")
        print("\n".join(lines))
        return 0

    if not sid:
        sid = session_id_from_env() or newest_session_id()
    rows = [r for r in ledger if (r.get("session") or "") == sid]
    session_row = next((d for d in db_rows(session_id=sid) if d["id"] == sid), None) if sid else None
    mode, source = resolve_mode(sid)
    if args.json:
        agg = summarize_ledger(rows)
        agg.update({
            "session_id": sid,
            "model": (session_row or {}).get("model"),
            "mode": mode,
            "mode_source": source,
            "savings": "unknown",
            "source": "ledger" if rows else "state.db",
        })
        print(json.dumps(agg, indent=2))
        return 0
    print(render_session_report(sid, rows, session_row, mode, source, share=args.share))
    return 0


def cmd_help(_args):
    print(__doc__.strip())
    print("""
usage:
  caveman status [--json] [--session ID]     show the mode for this session
  caveman set <mode> [--global]              caveman | ultracave | megacave | off
  caveman off | caveman normal               same as set off
  caveman stats [--json] [--share]           this session
  caveman stats --all | --since 7d           recorded sessions
  caveman help                               this text

The mode is enforced on every turn by the pre_llm_call hook
(caveman-mode-guard.py) and every API call is priced into
state/caveman-ledger.jsonl by the post_api_request hook (caveman-ledger.py).
""")
    return 0


def build_parser():
    p = argparse.ArgumentParser(prog="caveman", add_help=True, description="Hermes-native caveman mode + stats")
    sub = p.add_subparsers(dest="cmd")

    st = sub.add_parser("status")
    st.add_argument("--json", action="store_true")
    st.add_argument("--session")
    st.set_defaults(func=cmd_status)

    se = sub.add_parser("set")
    se.add_argument("mode")
    se.add_argument("--global", dest="global_scope", action="store_true")
    se.add_argument("--session")
    se.set_defaults(func=cmd_set)

    s = sub.add_parser("stats")
    s.add_argument("--json", action="store_true")
    s.add_argument("--share", action="store_true")
    s.add_argument("--all", action="store_true")
    s.add_argument("--since")
    s.add_argument("--session")
    s.set_defaults(func=cmd_stats)

    sub.add_parser("help").set_defaults(func=cmd_help)
    return p


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in OFF_VALUES[:1] + ("normal", "none", "stop"):
        argv = ["set", "off"] + argv[1:]
    elif argv and normalize_mode(argv[0]) and argv[0] not in ("status", "stats", "set", "help"):
        argv = ["set", argv[0]] + argv[1:]
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
